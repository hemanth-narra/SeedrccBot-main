# This is an example environment file.
# Copy this file to .env and fill in the values.

# Telegram Configuration (Required)
# Get these from my.telegram.org and @BotFather
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_BOT_TOKEN=

# Access Control / Whitelist (Highly Recommended for Private Use)
# Comma-separated list of Telegram User IDs allowed to use the bot.
# Example: ALLOWED_USER_IDS=123456789,987654321
# To find your Telegram User ID, message @userinfobot or @MissRose_bot on Telegram.
# If left blank, the bot will accept interactions from any Telegram user.
ALLOWED_USER_IDS=

# Security (Required)
# A secret key for encrypting sensitive data.
# You can generate one using: openssl rand -base64 32
ENCRYPTION_KEY=

# Database Configuration (Optional)
# The application uses SQLite by default.
# Uncomment the following line to use a different database, like PostgreSQL.
# DATABASE_URL=postgresql://user:password@host/dbname

# For more advanced settings
# see the Settings class in app/config.py.
